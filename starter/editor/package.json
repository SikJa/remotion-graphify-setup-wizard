{
  "name": "remotion-editor-kit",
  "version": "0.1.0",
  "description": "Public Remotion editor starter with Graphify-first agent rules, Hyperframes motion graphics, templates, components, and pipeline scripts.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/remotion-safe.mjs studio --browser=chrome --port 3010 --host 127.0.0.1",
    "build": "node scripts/remotion-safe.mjs bundle",
    "render": "node scripts/remotion-safe.mjs render",
    "still": "node scripts/remotion-safe.mjs still",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "analyze:video": "tsx scripts/analyze-video.ts",
    "extract:audio": "tsx scripts/extract-audio.ts",
    "transcribe": "tsx scripts/transcribe.ts",
    "detect:silence": "tsx scripts/detect-silence.ts",
    "remove:bg": "tsx scripts/remove-bg.ts",
    "clean:remotion-temp": "node scripts/clean-remotion-temp.mjs",
    "disk:report": "node scripts/disk-report.mjs",
    "hyperframes:lint": "npx hyperframes lint hyperframes",
    "hyperframes:validate": "npx hyperframes validate hyperframes"
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@remotion/captions": "4.0.465",
    "@remotion/cli": "4.0.465",
    "@remotion/install-whisper-cpp": "4.0.465",
    "@remotion/media": "4.0.465",
    "@remotion/media-utils": "4.0.465",
    "@remotion/noise": "4.0.465",
    "@remotion/player": "4.0.465",
    "@remotion/shapes": "4.0.465",
    "@remotion/transitions": "4.0.465",
    "fluent-ffmpeg": "^2.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.465",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@remotion/renderer": "4.0.465",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/react": "19.0.0",
    "@types/web": "0.0.166",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  },
  "license": "MIT"
}